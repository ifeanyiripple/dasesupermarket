// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String   @id @default(uuid())
  userId             String   @db.Uuid
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String?
  username      String?  @unique
  email         String?  @unique
  password      String?
  phoneNumber   String?  
  image         String?
  bio           String?
  role          UserRole @default(USER)
  addresses     Address[]   
  isChatEnabled          Boolean @default(true)
  isChatDelayed          Boolean @default(false)
  isChatFollowersOnly    Boolean @default(false)
  onboarded     Boolean @default(false)
  isTwoFactorEnabled Boolean @default(false)
  emailVerified DateTime?
  verifiedUser  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accounts      Account[]
  reviews       Review[]
  orders        Order[]
  twoFactorConfirmation TwoFactorConfirmation?
  deviceTokens  DeviceToken[]
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  label       String?          // "Home" | "Work" | "Other"
  fullName    String?
  phoneNumber String?
  state       String   @default("Oyo")
  lga         String           // e.g. "Ibadan North"
  town        String           // e.g. "Bodija"
  street      String?
  isDefault   Boolean  @default(false)
  latitude    Float?           // reserved for map feature
  longitude   Float?           // reserved for map feature
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Food {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  category    String
  description String
  price       Float
  image       String        // single Firebase URL
  badge       String?       // "Popular" | "Chef's Pick" | null
  spicy       Boolean  @default(false)
  rating      Float    @default(0)
  prepTime    String        // e.g. "25 min"
  meatOptions MeatOption[]
  serves      Int      @default(1)
  inStock     Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems    OrderItem[]
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
}

model Room {
  id          String     @id @default(cuid())
  name        String
  description String
  price       Float
  roomNumber  String?
  capacity    Int
  available   Int
  status      RoomStatus @default(AVAILABLE)
  bed         String?
  amenities   Json
  images      String[]   @default([])
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

}

model MeatOption {
  id        String  @id @default(uuid()) @db.Uuid
  foodId    String  @db.Uuid
  name      String
  price     Float
  isDefault Boolean @default(false)
  food      Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([foodId])
}


model VerificationToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(uuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id     String @id @default(uuid())
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}



model Product {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  description   String
 // vendor        String?
  price         Float
  originalPrice Float?                    // ← for showing crossed-out price
  brand         String?
  category      String
  inStock       Boolean
  badge         String?                   // ← "new" | "sale" | "hot" | "organic" | null
  isFeatured    Boolean  @default(false)  // ← for homepage featured section
  
  // ── New rich description fields ──────────────────────────────────
  netContent     String?         // e.g. "385 mL", "1kg", "500g"
  containerType  String?         // e.g. "Plastic Jar", "Carton", "Bottle"
  keyFeatures    String[]        // array of bullet points
  ingredients    String?         // full ingredients text (optional)
  storageInfo    String?         // e.g. "Store in a cool dry place"
  countryOfOrigin String?        // e.g. "Nigeria"
  
  images        Image[]
  reviews       Review[]
  orderItems    OrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid

  userId      String   @db.Uuid
  productId   String   @db.Uuid

  rating      Int
  comment     String

  createdDate DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  amount         Float
  currency       String
  status         String
  addressId      String?
  deliveryStatus DeliveryStatus @default(PENDING)
  createDate     DateTime    @default(now())
  referenceId    String      @unique
  address        String?
  
  
  phoneNumber    String?

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
   statusUpdates  OrderStatusUpdate[]
  @@index([userId])
}
// ── Delivery status enum (used on Order and OrderStatusUpdate) ─────────────────
enum DeliveryStatus {
  PENDING     // Order placed, awaiting confirmation
  CONFIRMED   // Store confirmed the order
  SHIPPED     // Out for delivery
  DELIVERED   // Successfully delivered
  CANCELLED   // Order cancelled
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
 
  productId   String?  @db.Uuid
  foodId      String?  @db.Uuid
  name        String
  description String
  category    String
  brand       String
  quantity    Int
  price       Float
  

  // selected image snapshot at time of order
  imageColor      String
  imageColorCode  String
  imageUrl        String

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: NoAction)
  food        Food?    @relation(fields: [foodId], references: [id], onDelete: NoAction)
 

  @@index([orderId])
  @@index([productId])
}


// ── Tracks every admin status change for an order (timeline / audit trail) ────
model OrderStatusUpdate {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @db.Uuid
  status    DeliveryStatus
  note      String?        // optional admin note, e.g. "Driver assigned: Emeka"
  createdAt DateTime       @default(now())

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}


model Image {
  id          String   @id @default(uuid()) @db.Uuid
  color       String
  colorCode   String
  image       String
  productId   String   @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum Role {
  USER
  ADMIN
}

model DeviceToken {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  token      String   @unique
  platform   String?  // "web", "android", "ios"
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
